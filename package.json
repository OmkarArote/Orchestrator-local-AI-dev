{
  "name": "local-ai-dev-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first task orchestrator: approve -> aider in git worktree -> check -> review -> approve merge",
  "main": "server.js",
  "bin": {
    "orc": "bin/orc.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.js\"",
    "eval": "node scripts/eval.js",
    "test:m0": "node --test --test-concurrency=4 \"test/m0-*.test.js\"",
    "setup": "./setup.sh",
    "doctor": "./setup.sh",
    "css": "tailwindcss -i public/css/input.css -o public/style.css",
    "css:watch": "tailwindcss -i public/css/input.css -o public/style.css --watch"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/OmkarArote/Orchestrator-local-AI-dev.git"
  },
  "keywords": [
    "ollama",
    "aider",
    "cursor",
    "local-ai",
    "orchestrator",
    "git-worktree"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
