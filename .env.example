# Copy to .env (git-ignored) and uncomment what you want to change. Real environment variables take precedence.
# Local model used by the `local` engine (aider) and for routing. Must be installed in Ollama (`ollama list`).
#ORCH_MODEL=ollama_chat/qwen2.5-coder:7b
# Folders where repositories may live (colon separated). Default: ~/work
#ORCH_AUTHORIZED_ROOTS=~/work:~/code
#ORCH_PROJECTS_PARENT=~/work
# Where task worktrees and logs go. Default: ~/work/local-ai-dev/{worktrees,logs}
#ORCH_WORKTREES=
#ORCH_LOG_DIR=
#ORCH_PORT=4310
# Allow the Models page to download Ollama models (each download still needs your confirmation). Default: off
#ORCH_ALLOW_MODEL_PULL=1
# Cursor CLI engine (uses your Cursor plan). There is no daily cap any more (ORCH_CURSOR_DAILY_CAP / ORCH_CURSOR_REVIEW_DAILY_CAP are ignored):
# usage is counted on the dashboard and every Cursor run still needs your approval click.
#ORCH_AIDER_BIN=
#ORCH_CURSOR_BIN=
